#!/usr/bin/env sh
set -e

# 1. Secret scanning of staged changes with Gitleaks (fails the commit on a finding)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --verbose
else
  echo "⚠️ gitleaks not found; skipping secret scan"
fi

# 2. Filter staged Rust source files (.rs)
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)

# 3. Format staged Rust files using rustfmt
if [ -n "$STAGED_RS_FILES" ]; then
  for file in $STAGED_RS_FILES; do
    if [ -f "$file" ]; then
      rustfmt --edition 2024 "$file"
    fi
  done
  git update-index --again
fi

# 4. Automatically repair machine-fixable lints and verify
if [ -n "$STAGED_RS_FILES" ]; then
  echo "🛠️ Attempting auto-fix for machine-applicable Clippy lints..."
  cargo clippy --fix --allow-dirty --allow-staged --workspace --all-targets || true

  # Re-format files modified by clippy fix and re-stage
  cargo fmt --all || true
  git update-index --again

  echo "🔍 Verifying clean build with cargo clippy..."
  cargo clippy --workspace --all-targets -- -D warnings || {
    echo "❌ Clippy warnings/errors found. Fix them before committing."
    exit 1
  }
fi